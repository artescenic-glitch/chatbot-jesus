# ============================================================
#  Variables de entorno del bot.
#  En VERCEL: Settings -> Environment Variables (pega cada una).
#  Para probar en local: copia este archivo como ".env".
# ============================================================

# --- WhatsApp Cloud API (Meta) ---
# Token PERMANENTE del Usuario del Sistema (empieza con EAA...)
WHATSAPP_TOKEN=

# Phone Number ID del numero 63558087 (NO es el numero, es un ID largo)
PHONE_NUMBER_ID=

# Palabra secreta que tu inventas; debe ser la MISMA en el webhook de Meta
VERIFY_TOKEN=artescenic2026

# --- Supabase (base de datos) ---
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de inscritos ---
# Clave para abrir /api/leads?key=LOQUEPONGASAQUI  (invéntala, larga)
LEADS_KEY=

# --- Reenvio al CRM (para responder consultas como humano) ---
# URL del webhook del CRM (wacrm)
CRM_WEBHOOK_URL=https://wacrm-tau-jet.vercel.app/api/whatsapp/webhook
# App Secret de Meta (App Settings -> Basic). El CRM lo exige para
# verificar la firma del reenvio. Es el MISMO de la app Artescenic1.
META_APP_SECRET=
